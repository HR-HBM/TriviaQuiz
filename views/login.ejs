<%- include("header.ejs") %>
<div class="main-container2">
    <div class="login-intro-images">

        <a href="/"><img src="/logo.png" alt="logo" class="mini-logo"></a>
        
        <div class="overlay"></div>
        <img src="/triviaImage.jpg" alt="Trivia Image" class="trivia-image">
        

    </div>

    <div class="credentials-section">
        <ul class="login-error">
            <% if(messages.success_msg) { %>
                <li><%= messages.success_msg %></li>
          <%  } %>
        </ul>
    
        
        <p class="page-title">Login to Continue</p>
        <p class="guest-user"> New user? Click here to <a href="/users/register"><span class="guest-user">Register</span></a></p>

        <div class="login-form-overlay register">
            <form action="/users/login" method="POST" class="login-register-form">
                <!-- <div>
                    <input type="text" name="name" id="name" placeholder="Name" required>
                </div> -->
                <div>
                    <input type="email" id="email" name="email" placeholder="Email" requried>
                </div>
                <div>
                    <input type="password" id="password" name="password" placeholder="Password" requried>
                    <span class="password-toggle-icon"><i class="fas fa-eye"></i></span>

                </div>
                
                <div>
                    <input type="submit" value="Login">
                </div>
            </form>
            

        </div>
        <ul class="login-error">
            <% if (messages.error){ %>
                <li> <%= messages.error %> </li>
    
           <% } %>
        </ul>

        <div class="oAuth-div">
            <div class="option-title">
                <div class="dash-line"></div>
                <div><p>or register with</p></div>
                <div class="dash-line"></div>
            </div>
    
            <div class="google-auth">
                <a href="google"> <button class="google"><img src="/google-logo-9808 1.png" alt="Google Icon" class="google-icon">
                    Google</button> </a>
    
    
            </div>
    
        </div>
        </div>
        </div>
    
        

    
    
    <%- include("footer.ejs") %>
